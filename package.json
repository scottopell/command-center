{
  "name": "command-center",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=26.12.0 <27"
  },
  "workspaces": [
    "packages/*",
    "functions/*"
  ],
  "scripts": {
    "typecheck": "node scripts/run.mjs typecheck",
    "lint": "node scripts/run.mjs lint",
    "test": "node scripts/run.mjs test",
    "build:web": "node scripts/run.mjs web",
    "build": "node scripts/build.mjs",
    "service:install": "node scripts/service.mjs install",
    "service:stop": "node scripts/service.mjs stop",
    "cli": "node dist/cli.mjs",
    "test:native": "node scripts/test-native.mjs",
    "check": "npm run typecheck && npm run lint && npm test",
    "check:specs": "node scripts/validate-specs.mjs",
    "prepare": "node scripts/configure.mjs",
    "configure": "node scripts/configure.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.105.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "smol-toml": "^1.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "esbuild": "^0.28.0",
    "typescript": "^6.0.0",
    "vite": "^8.0.0"
  }
}

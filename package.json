{
  "name": "command-center",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "26.12.0",
    "npm": "11.20.0"
  },
  "workspaces": [
    "packages/*",
    "functions/*"
  ],
  "scripts": {
    "typecheck": "node scripts/run.mjs typecheck",
    "lint": "node scripts/run.mjs lint",
    "test": "node scripts/run.mjs test",
    "build:web": "node scripts/build-web.mjs",
    "build": "node scripts/build.mjs",
    "service:install": "node scripts/service.mjs install",
    "service:stop": "node scripts/service.mjs stop",
    "cli": "node dist/cli.mjs",
    "test:native": "node scripts/test-native.mjs",
    "check": "npm run typecheck && npm run lint && npm test",
    "check:specs": "node scripts/validate-specs.mjs",
    "prepare": "node scripts/configure.mjs",
    "configure": "node scripts/configure.mjs",
    "doctor": "node scripts/doctor.mjs",
    "setup:native": "node scripts/setup-native.mjs",
    "smoke:service": "node scripts/smoke-service.mjs",
    "verify": "npm run doctor && npm run check && npm run build && npm run smoke:service && npm run test:native",
    "build:toolchain": "node scripts/build-toolchain.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "5.105.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "smol-toml": "1.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "typescript": "6.0.3"
  },
  "packageManager": "npm@11.20.0"
}
